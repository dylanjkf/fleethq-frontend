# Absolute base URL of the API (Railway), e.g. https://api.fleethq.online —
# no trailing slash. Required for any deployed build (e.g. Vercel); unset
# falls back to same-origin "/", which only works with the dev proxy in
# vite.config.ts (local dev only). See src/api/client.ts.
#
# You usually DON'T need to set this: if VITE_API_BASE is empty, the client
# falls back to VITE_API_URL — the same variable the customer app uses — so a
# single env var on a shared Vercel project configures both apps.
VITE_API_BASE=""
