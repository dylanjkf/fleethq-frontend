# Absolute base URL of the fleethq-platform API (Railway), e.g.
# https://api.fleethq.online — no trailing slash. Vite bakes VITE_* vars into
# the bundle at build time, so this must be set in the build environment
# (Vercel project settings), not read at runtime. Unset/empty falls back to
# same-origin `/` — correct for local dev (see vite.config.ts's proxy), wrong
# for a real deployment where the API is a separate origin. See src/api/client.ts.
VITE_API_URL=""

# Copy to .env.production (gitignored) before a production build if you want
# error tracking active for that build. Vite bakes VITE_* vars into the
# bundle at build time — there is no runtime env var for a static SPA, so
# this must be set before `npm run build` runs. Empty/unset is a safe no-op —
# see src/instrument.ts.
VITE_SENTRY_DSN=""

# The Stripe Price ID the Billing page's "Subscribe" button checks out. Same
# build-time-baked caveat as VITE_SENTRY_DSN above. When unset, the Subscribe
# button explains no plan is configured rather than sending an empty priceId.
VITE_STRIPE_PRICE_ID=""
